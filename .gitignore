# dependencies
node_modules/

# local toolchain
.tools/

# third-party reference clones (not part of this repo);
# except DeepSeek-Balance-Whale-Widget — the customized dsh-whale-widget fork
# this repo integrates (installed into the web profile via `file:` spec)
third-party/*
!third-party/DeepSeek-Balance-Whale-Widget/

# personal icon overrides (drop your own icon-*.png / icon.ico here)
src/main/assets/whale/

# setup completion marker
.setup-complete

# build output
dist/
out/

# logs
*.log
.DS_Store

# debugging screenshots (never commit screen captures)
studio-*.png
desktop-*.png
screen-*.png
taskbar-*.png
titlebar-*.png
window-hicon.png

# stray pnpm artifacts at project root (project is npm-based)
pnpm-lock.yaml
pnpm-workspace.yaml
